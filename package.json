{
  "name": "recruitai-resume-screening",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src public index.html vite.config.ts eslint.config.js package.json package-lock.json tsconfig.json README.md .prettierrc.json",
    "format:check": "prettier --check src public index.html vite.config.ts eslint.config.js package.json package-lock.json tsconfig.json README.md .prettierrc.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "antd": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint-react/eslint-plugin": "^5.20.8",
    "@eslint/css": "^2.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.9",
    "typescript": ">=5.9 <6.1"
  }
}
