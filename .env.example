DATABASE_URL=sqlite:///backend/data/screening.db
POSTGRES_SERVICE_NAME=postgresql-x64-18
START_POSTGRES_SERVICE=true
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:5173
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SEED_DEMO_USER=false
DEMO_USER_EMAIL=demo@recruitai.local
DEMO_USER_PASSWORD=
# Core resume matching and ranking run locally without an API key.
AI_PROVIDER=ollama
AI_MODEL=
# Optional hosted generation: set AI_PROVIDER=openai_compatible and use
# RM_AI_KEY (preferred) or AI_API_KEY for the provider key.
# AI_BASE_URL=https://api.groq.com/openai/v1
# RM_AI_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Public Hugging Face model, run locally via Ollama (no hosted inference fees).
# First-time download: ollama pull hf.co/Qwen/Qwen3-4B-GGUF:Q4_K_M
OLLAMA_MODEL=hf.co/Qwen/Qwen3-4B-GGUF:Q4_K_M
OLLAMA_KEEP_ALIVE=-1
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_PREDICT=512
# Optional structured extraction with local Ollama. Hosted providers are never
# used for resume/JD extraction; deterministic rules remain the default/fallback.
AI_EXTRACTION_ENABLED=false
RUN_EVALUATION_WORKER=true
# OCR for scanned PDFs and image resumes uses the separate Tesseract engine.
TESSERACT_CMD=
OCR_LANGUAGES=eng
OCR_MAX_PAGES=20
MATCH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set after encoder fine-tuning to activate the FastEmbed ONNX export.
# MATCH_EMBEDDING_PATH=backend/training/output/resume-encoder/fastembed
MATCH_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
MATCH_CPU_THREADS=4
MATCH_EXACT=0.30
MATCH_SEMANTIC=0.35
MATCH_BM25=0.20
MATCH_RERANKER=0.0
MATCH_EVIDENCE=0.15
MATCH_MUST_HAVE_GROUP=0.80
MATCH_NICE_TO_HAVE_GROUP=0.20
MATCH_MATCHED_THRESHOLD=0.68
MATCH_PARTIAL_THRESHOLD=0.40
MATCH_ENABLE_RERANKER=false
MATCH_SKILL_WEIGHT=0.40
MATCH_SEMANTIC_WEIGHT=0.35
MATCH_EXPERIENCE_WEIGHT=0.15
MATCH_QUALIFICATION_WEIGHT=0.10
VITE_GOOGLE_CLIENT_ID=443288765564-ileiomf2qvgvl8t0renuqbtnsjuhnvdf.apps.googleusercontent.com

# Twilio SendGrid Mail Send API; create an API key with Mail Send permission.
SENDGRID_API_KEY=
# Must be an authenticated sender address in SendGrid.
SENDGRID_FROM_EMAIL=
