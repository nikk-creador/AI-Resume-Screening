DATABASE_URL=sqlite:///backend/data/screening.db
POSTGRES_SERVICE_NAME=postgresql-x64-18
START_POSTGRES_SERVICE=true
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_ENV=development
AUTH_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
SEED_DEMO_USER=true
DEMO_USER_EMAIL=demo@recruitai.local
DEMO_USER_PASSWORD=RecruitAI-Demo-2026!
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_KEEP_ALIVE=-1
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_PREDICT=512
RUN_EVALUATION_WORKER=true
MATCH_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MATCH_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
MATCH_CPU_THREADS=4
MATCH_EXACT=0.30
MATCH_SEMANTIC=0.35
MATCH_RERANKER=0.20
MATCH_EVIDENCE=0.15
MATCH_MUST_HAVE_GROUP=0.80
MATCH_NICE_TO_HAVE_GROUP=0.20
MATCH_MATCHED_THRESHOLD=0.68
MATCH_PARTIAL_THRESHOLD=0.40
